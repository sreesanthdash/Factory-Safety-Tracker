ADMIN_USERNAME=replace-with-local-admin-name
ADMIN_PASSWORD=replace-with-a-private-password
MONGODB_URI=
MONGODB_DATABASE=factory_safety
VISION_SERVICE_URL=http://127.0.0.1:8765
PPE_MODEL_PATH=ai/models/ppe/best.pt
# Optional custom detector (for example spark/arc); bundled fire/smoke runs separately.
HAZARD_MODEL_PATH=
# Local pose model is included in ai/models/pose; override only to use another checkpoint.
POSE_MODEL_PATH=ai/models/pose/yolo26n-pose.pt
# Run ai/download_videomae.py once while online to cache the pretrained VideoMAE Kinetics model.
# Point ACTION_MODEL_PATH at a fine-tuned Hugging Face model folder for a site-specific classifier.
ACTION_MODEL_PATH=
ACTION_MODEL_ID=MCG-NJU/videomae-base-finetuned-kinetics
ACTION_FRAME_COUNT=16
ACTION_INFER_EVERY=1
ACTION_FIGHT_MIN_CONFIDENCE=0.78
ACTION_FALL_MIN_CONFIDENCE=0.45
ACTION_CONFIRM_WINDOW=8
DEVICE_INGEST_TOKEN=
